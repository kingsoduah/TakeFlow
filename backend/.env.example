# TakeFlow backend environment — placeholder values only. Never commit secrets.
# Copy to .env and fill in locally. Real Neon connection strings are managed
# by `neon env pull` in the repo-root .env.local (gitignored).

# Application
PORT=3000

# PostgreSQL (Neon). Canonical variable names (see Neon Prisma guide):
# - DATABASE_URL: pooled (-pooler) connection, for application queries.
# - DATABASE_URL_UNPOOLED: direct connection, for Prisma CLI / migrations.
# Provided automatically by `neon env pull` in the repo-root .env.local.
# Define them in backend/.env ONLY if you are not using `neon env pull`.
# (Even empty values there would shadow the real ones.)
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Auth (Phase 2). JWT_SECRET is REQUIRED at runtime. DATABASE_URL is REQUIRED
# at runtime (pooled Neon connection, provided by `neon env pull`).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Roqqu (Phase 4). Request auth header is environment-selected:
# staging -> x-staging-api-key, live -> x-api-key. The operator pastes the
# actual keys locally; they are never committed.
ROQQU_BASE_URL=https://service.roqqu.com/v1
ROQQU_ENV=staging
ROQQU_STAGING_API_KEY_HEADER=x-staging-api-key
ROQQU_STAGING_API_KEY=
ROQQU_API_KEY=
# Webhook decryption key: set to the STAGING key to process staging events,
# LIVE key in production. Only the first 32 characters are used (aes-256-ctr).
# Staging/live interchangeability is unverified — never assume.
ROQQU_WEBHOOK_API_KEY=
# Optional relay. Roqqu's Cloudflare shows a browser check to requests from
# cloud servers, so the hosted API sends its Roqqu calls through the
# roqqu-relay Worker (see roqqu-relay/README.md). To use it, point
# ROQQU_BASE_URL at the Worker, for example
# https://takeflow-roqqu-relay.<account>.workers.dev/v1, and set the same
# secret here as the Worker's RELAY_SECRET. Leave empty to call Roqqu directly.
ROQQU_RELAY_SECRET=

# Frontend (fiat pricing and checkout). Comma separated browser origins
# allowed by CORS, with no path. Leave empty to keep CORS off.
FRONTEND_ORIGINS=http://localhost:3100
# Reverse proxies in front of the app (1 on Vercel or Render, 0 when reached
# directly).
# The public rate limiter uses it to find the real client address.
TRUST_PROXY_HOPS=0

# Demo mode, for when no working Roqqu key is available. Receiving addresses
# are simulated and the payment page can send simulated deposits (hash
# prefix sim_) through the real matching code. Never turn this on with real
# money.
DEMO_PAYMENTS=false
