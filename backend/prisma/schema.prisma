generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are configured in prisma7.config.ts (Prisma 7).
}

// Phase 2 models: platform users and the businesses they own.
// Client/Invoice/Wallet/Transaction/WebhookEvent models arrive in Phase 3+.

model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  businesses   Business[]
}

model Business {
  id            String    @id @default(uuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName  String
  businessEmail String?
  businessType  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clients       Client[]
  invoices      Invoice[]
  wallets       Wallet[]
  transactions  Transaction[]

  @@index([ownerId])
}

model Client {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  invoices   Invoice[]

  @@index([businessId])
}

// Invoices are receivables. Monetary values use Prisma Decimal (numeric) —
// never JavaScript floats. amountOutstanding is stored (amount -
// amountReceived) and recalculated on every balance-affecting change.
// amountReceived changes ONLY through reconciliation (Phase 6+); manual
// payment statuses (PAID/PARTIALLY_PAID) are rejected until then.
model Invoice {
  id                String        @id @default(uuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoiceNumber     String
  description       String?
  amount            Decimal       @db.Decimal(30, 18)
  currency          String // Billing (fiat) currency, ISO 4217, e.g. USD
  cryptoAsset       String // Preferred crypto asset, e.g. USDT
  network           String // Blockchain network code, e.g. erc20
  issueDate         DateTime      @default(now())
  dueDate           DateTime
  paymentAddress    String? // Receiving address; assigned in Phase 4 (Roqqu)
  paymentReference  String        @unique // Public payment-page reference
  status            InvoiceStatus @default(DRAFT)
  amountReceived    Decimal       @default(0) @db.Decimal(30, 18)
  amountOutstanding Decimal       @db.Decimal(30, 18)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transactions      Transaction[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, status])
}

// Receiving addresses obtained from Roqqu. Inventory plus audit trail: an
// address may be generated before it is assigned, and matching primarily
// uses invoice.paymentAddress. Addresses are globally unique.
model Wallet {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId     String? // Invoice this address was generated for, if any
  address       String    @unique
  network       String
  customerEmail String?
  provider      String    @default("roqqu")
  createdAt     DateTime  @default(now())

  @@index([businessId])
  @@index([invoiceId])
}

// Raw inbound webhook deliveries. eventId is unique when the payload could
// be decrypted; undecryptable bodies are stored with a null eventId (several
// allowed) for audit. Redeliveries of unfinished events resume processing.
model WebhookEvent {
  id               String                  @id @default(uuid())
  provider         String                  @default("roqqu")
  eventId          String?                 @unique
  eventType        String?
  transactionHash  String?
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  payload          Json
  errorMessage     String?
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?

  @@index([transactionHash])
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
  DUPLICATE
}

// Verified incoming payments. transactionHash is globally unique: the same
// on-chain payment is never credited twice, even across redeliveries.
// businessId is null only for deposits to addresses TakeFlow does not own.
model Transaction {
  id                   String               @id @default(uuid())
  businessId           String?
  business             Business?            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId            String?
  invoice              Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  transactionHash      String               @unique
  receivingAddress     String
  senderAddress        String?
  asset                String // Token symbol, uppercased, e.g. USDT
  network              String
  amount               Decimal              @db.Decimal(30, 18)
  excessAmount         Decimal              @default(0) @db.Decimal(30, 18)
  providerReference    String?
  providerStatus       Int? // Raw Roqqu numeric status: recorded, never interpreted
  reconciliationStatus ReconciliationStatus @default(PENDING)
  occurredAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([businessId])
  @@index([invoiceId])
  @@index([receivingAddress])
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  UNMATCHED
}

// Canonical invoice lifecycle (approved Phase 1 decision).
// Overpayments are represented by a separate reconciliation flag + excess
// amount on the payment record, never as an invoice status.
// Underpayments are PARTIALLY_PAID with a remaining outstanding balance.
enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  EXPIRED
}

// NOTE (Phase 4): User, Business, Client, Invoice, Wallet, WebhookEvent and
// Transaction are live. No further models are planned for the hackathon MVP.
